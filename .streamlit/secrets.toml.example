# Copy to .streamlit/secrets.toml for local testing, or paste into
# Streamlit Cloud -> your app -> Settings -> Secrets. NEVER commit the real file.

[supabase]
url = "https://YOUR-PROJECT.supabase.co"
anon_key = "eyJ...anon..."                 # Project Settings -> API -> anon public
service_role_key = "eyJ...service_role..." # Project Settings -> API -> service_role (secret!)

[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "any-long-random-string"   # e.g. python -c "import secrets;print(secrets.token_hex(32))"

[auth.google]
client_id = "....apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
